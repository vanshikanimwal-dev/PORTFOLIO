# Optional. Raises the GitHub API rate limit for `npm run sync:github`.
GITHUB_TOKEN=

# Resend API key. Without it, the contact form returns a configuration error.
RESEND_API_KEY=

# Inbox that should receive contact messages.
CONTACT_TO_EMAIL=vanshikanimwal2005@gmail.com

# Verified sender. Resend's shared test sender works before a custom domain is verified.
RESEND_FROM="Portfolio <onboarding@resend.dev>"

# Public site URL used for metadata, sitemap, RSS, and JSON-LD.
# TODO: set this to the production Vercel URL after deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
